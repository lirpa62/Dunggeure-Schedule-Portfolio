# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Naver OAuth
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NEXT_PUBLIC_NAVER_CALLBACK_URL=https://yourdomain.com/api/auth/naver/callback

# Admin (초기 설정용)
ADMIN_INITIAL_PASSWORD=your_admin_initial_password

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare R2 이미지 저장소 (선택)
# 설정하면 일정/공지/데코/스티커/프로필 이미지 업로드가 Supabase Storage 대신 R2로 저장됩니다.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://assets.yourdomain.com

# 공공데이터포털 특일정보 API (대체공휴일 보강용, 선택)
# https://www.data.go.kr/data/15012690/openapi.do 에서 발급
HOLIDAY_API_KEY=your_data_go_kr_service_key
